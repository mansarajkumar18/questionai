# ===================================================================
# Q-GEN AI Backend Engine Configuration
# ===================================================================

PORT=5000
DATABASE_URL="file:./dev.db"

# Security Secrets (Must be changed in production)
JWT_SECRET="replace_with_a_secure_random_key_in_production"
JWT_EXPIRES_IN="7d"

# Google Gemini AI Integration (Required for AI paper generation)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"

# File Storage & CORS
UPLOAD_DIR="./uploads"
FRONTEND_URL="http://localhost:5173"
